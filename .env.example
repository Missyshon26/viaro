# Backend API (viaro-backend).
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# The other Viaro applications, for cross-links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DRIVER_URL=http://localhost:3001
NEXT_PUBLIC_COMPANY_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Integrations not connected yet. Screens that need one are BUILT and render a
# labelled placeholder until the value is filled in.
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false

# Report exports are generated asynchronously by the backend (BullMQ). Blank means the
# export button polls the job endpoint rather than streaming.
NEXT_PUBLIC_EXPORTS_ENABLED=true
