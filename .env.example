# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Never prefixed with NEXT_PUBLIC_ — these must not reach the
# browser. The app uses a BFF pattern: the browser talks to Next Route Handlers,
# which hold the tokens and call the backend from the server.
# ─────────────────────────────────────────────────────────────────────────────

# viaro-backend. Note the port: 5001, not 5000 (5000 is taken by another app).
API_URL=http://localhost:5001

# Transactional email (Resend). Leave blank to disable sending in development.
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Public. These are inlined into the client bundle — no secrets here.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Socket.io connects from the browser directly, so this one must be public.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# The other Viaro applications. This site is the PASSENGER product only — chauffeurs,
# the platform admin and fleet operators each have their own app, and /portal links a
# signed-in non-passenger to the right one.
NEXT_PUBLIC_DRIVER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Integrations that are not connected yet. Every screen that depends on one is
# BUILT and reachable — it renders a labelled placeholder until the value below is
# filled in, then switches to the live version. Nothing is hidden behind a flag.
# ─────────────────────────────────────────────────────────────────────────────

# Live car tracking map. Set the provider and key to replace the placeholder panel
# on /trips/[id]/track with a real map.  ('mapbox' | 'google' | empty)
# Route preview on the booking flow (the map + distance banner above the wizard).
# Two separate things, both blank for now — each degrades on its own:
#
#   MAP        draws the route. Blank renders a labelled placeholder panel instead.
#   DIRECTIONS supplies distance and journey time. Blank shows "—" rather than a guess,
#              because an invented mileage on a quote screen is a number a customer
#              would reasonably believe.
#
# Google needs the Maps Embed API (map) and the Directions API (distance/time) enabled
# on the same key. Mapbox uses Static Images and the Directions API.
#   'google' | 'mapbox' | empty
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAP_API_KEY=

# Usually the same key as above. Set it separately only if the provider differs.
# Server-only: Directions and Places are called from Route Handlers (/api/directions,
# /api/places/autocomplete), so this key never enters the browser bundle. Only the
# Embed key above has to be public, because an iframe src cannot hide it.
DIRECTIONS_PROVIDER=
DIRECTIONS_API_KEY=

# Public flags only — these say the server-side lookups are configured, and carry no
# credential. Places also needs the Places API enabled on DIRECTIONS_API_KEY.
NEXT_PUBLIC_DIRECTIONS_PROVIDER=
NEXT_PUBLIC_PLACES_ENABLED=

# Realtime. The backend exposes socket namespaces /tracking/:tripId and /chat/:tripId.
# With this blank, tracking and chat fall back to REST polling of the same data.
NEXT_PUBLIC_REALTIME_ENABLED=false

# Card capture. POST /payments/methods needs a gatewayToken from the provider's SDK,
# so /account cannot add a card until this is set. ('stripe' | empty)
NEXT_PUBLIC_PAYMENT_PROVIDER=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cancellations and late changes are handled by a person, not a button — the refund
# depends on how close to pickup the customer is, and that should be agreed on a call.
# Leave blank and the UI routes to the support form instead of showing a fake number.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
