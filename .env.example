NODE_ENV=development
PORT=5000

MONGO_URI=
# Optional safety net: the app refuses to start unless MONGO_URI ends in exactly this database name.
# Strongly advised when the cluster also holds other databases.
EXPECTED_DB_NAME=
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=*

# Rate limits. These defaults are the production posture — raise AUTH_RATE_LIMIT_MAX
# locally if you run the Postman collection repeatedly (it logs in ~15 times per run).
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# ---------------------------------------------------------------------------
# Flight data — aviationstack | flightaware
# Leave the provider blank to use mock flight data (the app still runs).
#   aviationstack: FLIGHT_API_KEY = your access_key
#   flightaware:   FLIGHT_API_KEY = your AeroAPI x-apikey
# ---------------------------------------------------------------------------
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=

# ---------------------------------------------------------------------------
# Payment gateway — stripe
# Leave the provider blank for mock charges (no money moves).
#   PAYMENT_GATEWAY_SECRET_KEY     = sk_live_... / sk_test_...
#   PAYMENT_GATEWAY_WEBHOOK_SECRET = whsec_...  (Stripe Dashboard -> Webhooks)
#   The webhook endpoint must send these events: payment_intent.succeeded, charge.refunded and
#   checkout.session.completed (the last one marks an emailed payment link as paid).
#   Point the webhook endpoint at  POST /payments/webhook, events: payment_intent.succeeded,
#   charge.refunded. Locally: `stripe listen --forward-to localhost:5001/payments/webhook`.
#   With PAYMENT_GATEWAY_PROVIDER=stripe, bookings are paid by card at checkout
#   (POST /bookings/checkout/intent then /bookings/checkout); plain POST /bookings is refused.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS / push — twilio | firebase | expo
# Leave the provider blank to only log what would have been sent.
#   twilio:   SMS_PUSH_API_KEY = auth token, plus the two TWILIO_* keys
#   firebase: SMS_PUSH_API_KEY or FCM_ACCESS_TOKEN = OAuth token, plus FCM_PROJECT_ID
#   expo:     SMS_PUSH_API_KEY = Expo access token
# ---------------------------------------------------------------------------
SMS_PUSH_PROVIDER=
SMS_PUSH_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Transactional email — password resets, welcome, booking confirmed / updated /
# cancelled, chauffeur assigned, trip receipt, refunds, cancellation reminders, and
# support-case alerts.
# Sent over SMTP (connects over IPv4 — Render cannot route IPv6 to mail servers). Leave
# SMTP_HOST blank to only log what would have been sent (local only: the log line is
# redacted in production, since a reset link is an account takeover).
# ---------------------------------------------------------------------------
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Operations inbox copied on every new booking and cancellation. Blank = the support
# inbox set in the admin console (Settings).
BOOKINGS_INBOX_EMAIL=

# ---------------------------------------------------------------------------
# Public URL of the customer web app.
# Password-reset links are built from this — leave it at the localhost default in a
# deployment and every reset email you send will point at the recipient's own machine.
# ---------------------------------------------------------------------------
APP_WEB_URL=http://localhost:3000
# The admin console's address: the "View trip" button in emails to operations. Optional.
ADMIN_WEB_URL=

# ---------------------------------------------------------------------------
# "Sign in with Google" (passenger site)
# ---------------------------------------------------------------------------
# The OAuth *Web* client id from Google Cloud (APIs & Services > Credentials). It is public;
# there is no client secret in this flow. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the
# passenger site. Empty = Google sign-in is off.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Google Calendar sync (every booking appears on one shared calendar for operations)
# ---------------------------------------------------------------------------
# GOOGLE_CALENDAR_ID: the calendar's id (Calendar settings > Integrate calendar).
# GOOGLE_SERVICE_ACCOUNT_JSON: the whole JSON key of a service account, on ONE line. Share the
# calendar with that account's client_email, permission "Make changes to events". Both set =
# on; either empty = off. Never commit the key.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or write straight into a person's own calendar, with no sharing at all (domain-wide delegation):
# set this to their address (e.g. reservations@allblacklimoseattle.com) and GOOGLE_CALENDAR_ID to the
# same address. A Workspace admin must first authorise the service account's Client ID in Admin
# console > Security > Access and data control > API controls > Domain-wide delegation, with the
# scopes https://www.googleapis.com/auth/calendar.events and https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CALENDAR_IMPERSONATE=

# ---------------------------------------------------------------------------
# Driver document storage (licence / insurance)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Vehicle photos uploaded in the admin console
# ---------------------------------------------------------------------------
# DEPLOY NOTE: photos are files on this server's disk. UPLOAD_DIR must be on a PERSISTENT
# volume with room to grow (a container's own filesystem is wiped on every deploy, taking
# every photo with it). PUBLIC_API_URL is this API's public address; photo links are built
# from it. Leave UPLOAD_DIR blank locally to use ./uploads.
UPLOAD_DIR=
PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Not configured here any more:
#   Default driver payout, company/platform revenue split, withdrawal fee and the
#   support inbox are edited in the admin console (Drivers → Settings).
#   Timezone and login-session lengths are constants in src/config/constants.ts.
# ---------------------------------------------------------------------------


# Old-site customers: the web API key of the old Firebase project (Firebase console > Project settings); lets first login check their old password. Set it in the real environment, never in this file.
FIREBASE_WEB_API_KEY=

# Server-side Google Directions key: measures a journey for per-mile pricing. Blank = such classes are priced at their flat rate.
GOOGLE_MAPS_SERVER_KEY=
# Only bookings made at or after this moment are put on the calendar (ISO date-time), so test bookings
# already in the database stay off a real calendar. Empty = every booking.
GOOGLE_CALENDAR_SYNC_FROM=

# ---------------------------------------------------------------------------
# GoHighLevel (the CRM) — feedback survey after a completed trip
# ---------------------------------------------------------------------------
# When a trip is completed the customer is added to GoHighLevel as a contact tagged "service
# completed"; a workflow in GoHighLevel ("Post-Service Feedback Survey") watches that tag and sends the
# survey. Either value blank = off.
#   GHL_API_TOKEN:   Settings > Private Integrations > Create new (scope: contacts.write)
#   GHL_LOCATION_ID: Settings > Business Profile (the sub-account's id)
GHL_API_TOKEN=
GHL_LOCATION_ID=
# The tag the workflow watches for (blank = "service completed").
GHL_SERVICE_COMPLETED_TAG=

# Blind copy of every invoice / payment-link email an operator sends a customer.
# Defaults to reservations@allblacklimoseattle.com when unset; blank = off.
INVOICE_BCC_EMAIL=reservations@allblacklimoseattle.com
