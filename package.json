{
  "name": "viaro-backend",
  "version": "0.1.0",
  "description": "Viaro ride-hailing backend",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "postman:generate": "node scripts/generate-postman.js",
    "seed": "tsc -p tsconfig.json && node dist/scripts/seed.js",
    "seed:clean": "tsc -p tsconfig.json && node dist/scripts/seed.js clean",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:api": "newman run postman/Viaro-Backend.postman_collection.json -e postman/Viaro-Local.postman_environment.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "newman": "^6.2.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
